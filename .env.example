# Application Configuration
NODE_ENV=development
PORT=3000
APP_NAME=Viarduct
API_BASE_URL=http://localhost:3000/api
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=viarduct
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# Security & Authentication (JWT)
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_REFRESH_EXPIRATION=7d
JWT_RESET_SECRET=your_jwt_reset_secret_here
JWT_RESET_EXPIRATION=1h

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# AWS Services (S3, SES, Rekognition)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID_KYC=your_aws_access_key
AWS_SECRET_ACCESS_KEY_KYC=your_aws_secret_key
# Optional AWS SES Email
AWS_SES_FROM_EMAIL=no-reply@yourdomain.com

# Cloudinary (Media Storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Twilio (SMS, WhatsApp, Verification)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=your_verify_service_sid
TWILIO_PHONE_NUMBER=your_twilio_phone_number
TWILIO_WHATSAPP_NUMBER=your_twilio_whatsapp_number

# Email provider: smtp | sendgrid | brevo
# smtp  → uses SMTP_* below (Gmail, etc.)
# brevo → uses BREVO_SMTP_* below (no need to comment/uncomment blocks when switching)
EMAIL_PROVIDER=smtp

# Default SMTP (when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_user
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=no-reply@yourdomain.com

# SendGrid (when EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=no-reply@yourdomain.com
SENDGRID_TEMPLATE_ID=your_sendgrid_dynamic_template_id

# Brevo SMTP (when EMAIL_PROVIDER=brevo)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=2525
BREVO_SMTP_USERNAME=your_login@smtp-brevo.com
BREVO_SMTP_PASSWORD=your_xsmtpsib_smtp_key
BREVO_SENDER_EMAIL=no-reply@yourdomain.com
# Legacy: BREVO_API_KEY is accepted as SMTP password if it starts with xsmtpsib-
# Use 2525 (or 465) if port 587 times out on your network

# Stripe (Payments)
# Note: Client-side keys are typically in frontend .env, but backend needs secret
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Microservices URLs (Inter-service communication)
PAYMENT_SERVICE_URL=http://localhost:3002
PAYMENT_SERVICE_API_KEY=your_internal_api_key
NOTIFICATION_SERVICE_URL=http://localhost:3003

VERIFYME_API_KEY=verifyme_api_key



# Production SSL (Optional - for local dev leave empty)
# SSL_CA=/path/to/ca.pem
# SSL_KEY=/path/to/key.pem
# SSL_CERT=/path/to/cert.pem

# Ethereum (set ENABLE_ETHEREUM=false to disable wallet service at startup)
ENABLE_ETHEREUM=true
ETHEREUM_NETWORK=sepolia
ETHEREUM_RPC_URL=https://sepolia.infura.io/v3/your_infura_project_id
# ETHEREUM_INFURA_API_SECRET=optional_if_infura_requires_it
# ETHEREUM_CHAIN_ID=11155111
ETHERSCAN_API_KEY=your_etherscan_api_key
# Optional dedicated ETH seed (64 hex chars AES-encrypted). If unset, uses BITCOIN_* seed.
# ETHEREUM_ENCRYPTION_KEY=
# ETHEREUM_MASTER_SEED_ENCRYPTED=

# Platform sweep (consolidate platform-owned crypto to vault)
MASTER_VAULT_ADDRESS=your_btc_vault_address
MASTER_ETH_VAULT_ADDRESS=your_eth_vault_address
PLATFORM_BTC_SWEEP_ENABLED=true
PLATFORM_ETH_SWEEP_ENABLED=true
MIN_SWEEP_THRESHOLD_BTC=0.005
MIN_SWEEP_THRESHOLD_ETH=0.01
MAX_SATS_PER_VBYTE=50
MAX_SWEEP_FEE_GWEI=80
MAX_SWEEP_INPUTS_PER_TX=150
PLATFORM_BTC_SWEEP_MAX_ACCOUNTS=200
PLATFORM_ETH_SWEEP_MAX_ACCOUNTS=200

# Controlled P2P trade intents (invoice-driven flow)
CUSTODY_PROVIDER=inhouse
ENABLE_LEGACY_CUSTODIAL_TRADING=true
PLATFORM_TRADE_INTENT_SWEEP_ENABLED=true
PLATFORM_TRADE_INTENT_SWEEP_HOURS=12
