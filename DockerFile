FROM node:18-alpine

WORKDIR /app

# Install pnpm (recommended in your README)
RUN npm install -g pnpm

# Copy dependency files first (better caching)
COPY package.json pnpm-lock.yaml* ./

RUN pnpm install --frozen-lockfile

# Copy source code
COPY . .

# Build TypeScript
RUN pnpm build

# Expose Fly runtime port
EXPOSE 3000

# Start app
CMD ["pnpm", "start"]
